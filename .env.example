# 使用真实 SQLite API 时保持 false（默认值）
VITE_ENABLE_MOCK_API=false
VITE_API_BASE_URL=/api
# 子路径部署时设置，例如 /platform/；根路径部署保持 /
VITE_BASE=/
# RAG 后端开发代理目标与浏览器请求前缀
VITE_RAG_PROXY_TARGET=http://127.0.0.1:8000
VITE_RAG_API_BASE_URL=/rag-api

# server/index.mjs 配置
API_PORT=8787
# DATABASE_PATH=/absolute/path/to/platform.sqlite
# CORS_ORIGIN=http://localhost:5173
